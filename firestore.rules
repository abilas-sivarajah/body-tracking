rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isMember() {
      return request.auth != null && request.auth.token.member == true;
    }
    function isOwner(uid) {
      return isMember() && request.auth.uid == uid;
    }
    function isDay(id) {
      return id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function incoming() {
      return request.resource.data;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      // Das Konto legt der Server an, löschen läuft über /api/account.
      allow update: if isOwner(uid)
        && incoming().username is string
        && incoming().username.size() >= 2 && incoming().username.size() <= 30
        && incoming().keys().hasOnly(['username', 'goals', 'leaderboardOptIn', 'createdAt'])
        && (!('goals' in incoming()) || incoming().goals is map)
        && (!('leaderboardOptIn' in incoming()) || incoming().leaderboardOptIn is bool);

      match /days/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDay(date)
          && incoming().date == date
          && incoming().keys().hasOnly(['date', 'createdAt', 'entries', 'plannedIds', 'note', 'bw', 'sl'])
          && (!('entries' in incoming()) || (incoming().entries is map && incoming().entries.size() <= 200))
          && (!('plannedIds' in incoming()) || (incoming().plannedIds is list && incoming().plannedIds.size() <= 200))
          && (!('note' in incoming()) || (incoming().note is string && incoming().note.size() <= 300))
          && (!('bw' in incoming()) || (incoming().bw is number && incoming().bw >= 30 && incoming().bw <= 250))
          && (!('sl' in incoming()) || incoming().sl is map);
      }

      match /food/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDay(date)
          && incoming().date == date
          && incoming().keys().hasOnly(['date', 'items'])
          && incoming().items is list && incoming().items.size() <= 80;
      }

      match /water/{date} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isDay(date)
          && incoming().date == date
          && incoming().keys().hasOnly(['date', 'log', 'ml'])
          && incoming().log is list && incoming().log.size() <= 200;
      }

      match /meta/plan {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && incoming().exercises is list && incoming().exercises.size() <= 300
          && incoming().plans is map && incoming().plans.size() <= 50
          && incoming().schedule is map && incoming().schedule.size() <= 7
          && incoming().history is list && incoming().history.size() <= 60;
      }

      match /meta/foods {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid)
          && incoming().items is list && incoming().items.size() <= 500;
      }
    }

    // Nur der Server schreibt, damit Werte nicht direkt gesetzt werden können.
    match /leaderboard/{docId} {
      allow read: if isMember();
      allow write: if false;
    }

    // Einladungscodes sind ausschließlich für den Server.
    match /invites/{code} {
      allow read, write: if false;
    }
  }
}
